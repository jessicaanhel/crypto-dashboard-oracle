[Unit]
Description=Analytics dashboard backend (API + alert scheduler)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/analytics-dashboard/backend
EnvironmentFile=/etc/analytics-dashboard.env
ExecStart=/home/ubuntu/analytics-dashboard/backend/.venv/bin/gunicorn -w 1 --threads 4 -b 127.0.0.1:5000 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
